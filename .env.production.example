# Compose and database
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32

# Temporary access gate for https://roomvi.ru/release.
RELEASE_AUTH_USER=roomvi-preview
# Keep the bcrypt hash in single quotes so Compose treats every $ literally.
RELEASE_AUTH_PASSWORD_HASH='replace_with_caddy_hash_password_output'

# API sessions
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=2592000000
GUEST_SESSION_TTL_DAYS=7
GUEST_PREVIEW_GENERATION_LIMIT=1
GUEST_HASH_SALT=replace_with_openssl_rand_hex_32

# External S3-compatible object storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-central1
S3_BUCKET=roomvi
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_PUBLIC_BASE_URL=https://cdn.example.com/roomvi
S3_FORCE_PATH_STYLE=false
B2B_DOWNLOAD_ALLOWED_ORIGINS=

# Queue and generation
GENERATION_WORKER_CONCURRENCY=2
GENERATION_PROVIDER=MOCK
GENERATION_VERBOSE_LOGS=false
AI_REFERENCE_IMAGE_MAX_SIZE_MB=10
AI_REFERENCE_IMAGE_MAX_DIMENSION=768
AI_REFERENCE_IMAGE_JPEG_QUALITY=82
AI_REFERENCE_IMAGE_MIN_SIZE_KB=5

# Required when GENERATION_PROVIDER=NANO_BANANA
YESAI_API_KEY=
YESAI_API_BASE_URL=https://api.yesai.su
YESAI_NANO_BANANA_VERSION=v.2
YESAI_NANO_BANANA_STYLE=7,16,43
YESAI_NANO_BANANA_DIMENSIONS=16:9
YESAI_NANO_BANANA_RESOLUTION=1k
YESAI_NANO_BANANA_INITIAL_POLL_DELAY_MS=18000
YESAI_NANO_BANANA_POLL_INTERVAL_MS=10000
YESAI_NANO_BANANA_TIMEOUT_MS=180000

# Optional reasoning and product curation
REASONING_AI_API_KEY=
REASONING_AI_BASE_URL=https://api.openai.com/v1
REASONING_AI_MODEL=gpt-5.6-luna
REASONING_AI_REASONING_EFFORT=low
REASONING_AI_TIMEOUT_MS=60000
PRODUCT_CURATION_AI_ENABLED=true
PRODUCT_CURATION_AI_MODEL=gpt-4.1-mini
PRODUCT_CURATION_AI_API_MODE=chat_completions
PRODUCT_CURATION_AI_TIMEOUT_MS=30000
