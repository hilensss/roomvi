generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MANAGER
  ADMIN
}

enum SupplierStatus {
  ACTIVE
  DISABLED
}

enum SupplierProductRawStatus {
  ACTIVE
  OUT_OF_STOCK
  REMOVED
  ERROR
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
}

enum ProductCategory {
  SOFA
  BED
  ARMCHAIR
  CHAIR
  TABLE
  COFFEE_TABLE
  TV_STAND
  WARDROBE
  DRESSER
  SHELF
  DESK
  LAMP
  RUG
  DECOR
  MATTRESS
  OTHER
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  KIDS_ROOM
  OFFICE
  HALLWAY
  BATHROOM
  STUDIO
}

enum InteriorStyle {
  MODERN
  MINIMALISM
  SCANDI
  LOFT
  CLASSIC
  NEOCLASSIC
  JAPANDI
  PROVENCE
  ECO
  HIGH_TECH
}

enum RoomProjectStatus {
  DRAFT
  READY_TO_GENERATE
  GENERATING
  GENERATED
  SELECTED
  ORDER_CREATED
  ARCHIVED
}

enum GenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum GenerationOwnerType {
  USER
  GUEST
}

enum GenerationProvider {
  MOCK
  MIDJOURNEY
  STABLE_DIFFUSION
  NANO_BANANA
}

enum GenerationScenario {
  MARKETPLACE
  B2B_FURNITURE_LINE
}

enum B2BProjectType {
  FURNITURE_LINE
}

enum B2BProjectStatus {
  DRAFT
  READY_TO_GENERATE
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  name           String?
  phone          String?
  role           UserRole        @default(USER)
  refreshTokens  RefreshToken[]
  guestSessions  GuestSession[]
  roomProjects   RoomProject[]
  generationJobs GenerationJob[]
  b2bProjects    B2BProject[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  files File[]

  carts Cart[]
  orders Order[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([jti])
}

model GuestSession {
  id                      String          @id @default(uuid())
  anonymousId             String          @unique @default(uuid())
  ipHash                  String?
  userAgentHash           String?
  previewGenerationsUsed  Int             @default(0)
  previewGenerationsLimit Int             @default(1)
  firstSeenAt             DateTime        @default(now())
  lastSeenAt              DateTime        @default(now())
  expiresAt               DateTime
  convertedUserId         String?
  convertedAt             DateTime?
  convertedUser           User?           @relation(fields: [convertedUserId], references: [id], onDelete: SetNull)
  roomProjects            RoomProject[]
  generationJobs          GenerationJob[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  files File[]

  @@index([expiresAt])
  @@index([convertedUserId])
  
  carts Cart[]
  orders Order[]
}

model Supplier {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  status      SupplierStatus       @default(ACTIVE)
  websiteUrl  String?
  logoUrl     String?
  productsRaw SupplierProductRaw[]
  products    Product[]
  b2bProjects B2BProject[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  supplierOrders SupplierOrder[]
}

model SupplierProductRaw {
  id          String                   @id @default(uuid())
  supplierId  String
  supplier    Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  externalId  String
  title       String?
  url         String?
  rawPayload  Json
  payloadHash String
  status      SupplierProductRawStatus @default(ACTIVE)
  lastSeenAt  DateTime                 @default(now())
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  product     Product?

  @@unique([supplierId, externalId])
  @@index([supplierId])
  @@index([externalId])
  @@index([payloadHash])
}

model Product {
  id                    String                 @id @default(uuid())
  supplierId            String
  supplier              Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  rawProductId          String?                @unique
  rawProduct            SupplierProductRaw?    @relation(fields: [rawProductId], references: [id], onDelete: SetNull)
  externalId            String
  title                 String
  description           String?
  category              ProductCategory
  roomTypes             RoomType[]
  styleTags             InteriorStyle[]
  price                 Int
  oldPrice              Int?
  currency              String                 @default("RUB")
  stockStatus           StockStatus            @default(UNKNOWN)
  imageUrls             String[]
  productUrl            String?
  widthCm               Int?
  heightCm              Int?
  depthCm               Int?
  material              String?
  color                 String?
  isActive              Boolean                @default(true)
  isAiEligible          Boolean                @default(true)
  designVariantProducts DesignVariantProduct[]
  b2bProjectProducts    B2BProjectProduct[]
  lastSyncedAt          DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([supplierId, externalId])
  @@index([supplierId])
  @@index([category])
  @@index([stockStatus])
  @@index([isActive])
  @@index([isAiEligible])
  @@index([price])

  cartItems CartItem[]
  orderItems OrderItem[]
}

model RoomProject {
  id                      String              @id @default(uuid())
  ownerType               GenerationOwnerType
  userId                  String?
  user                    User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId          String?
  guestSession            GuestSession?       @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  title                   String?
  roomType                RoomType
  style                   InteriorStyle
  budgetMin               Int?
  budgetMax               Int?
  widthCm                 Int?
  heightCm                Int?
  depthCm                 Int?
  sourceImageUrl          String?
  status                  RoomProjectStatus   @default(DRAFT)
  generationJobs          GenerationJob[]
  designVariants          DesignVariant[]
  b2bProject              B2BProject?
  selectedDesignVariantId String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([userId])
  @@index([guestSessionId])
  @@index([roomType])
  @@index([style])
  @@index([status])

  cartItems CartItem[]
}

model GenerationJob {
  id             String              @id @default(uuid())
  ownerType      GenerationOwnerType
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?
  guestSession   GuestSession?       @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  roomProjectId  String
  roomProject    RoomProject         @relation(fields: [roomProjectId], references: [id], onDelete: Cascade)
  provider       GenerationProvider  @default(MOCK)
  status         GenerationJobStatus @default(PENDING)
  scenario       GenerationScenario  @default(MARKETPLACE)
  requestedVariants Int?

  externalJobId  String?
  progress       Int                 @default(0)
  currentStep    String?

  prompt         String?
  negativePrompt String?
  inputParams    Json?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  designVariants DesignVariant[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@index([guestSessionId])
  @@index([roomProjectId])
  @@index([status])
  @@index([provider])
  @@index([scenario])
}

model DesignVariant {
  id              String                 @id @default(uuid())
  roomProjectId   String
  roomProject     RoomProject            @relation(fields: [roomProjectId], references: [id], onDelete: Cascade)
  generationJobId String
  generationJob   GenerationJob          @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  title           String?
  description     String?
  imageUrl        String
  totalPrice      Int?
  currency        String                 @default("RUB")
  products        DesignVariantProduct[]
  isSelected      Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([roomProjectId])
  @@index([generationJobId])
  @@index([isSelected])
  
  cartItems CartItem[]
}

model DesignVariantProduct {
  id              String        @id @default(uuid())
  designVariantId String
  designVariant   DesignVariant @relation(fields: [designVariantId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  role            String?
  x               Float?
  y               Float?
  productSnapshot Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([designVariantId, productId])
  @@index([designVariantId])
  @@index([productId])
}

model B2BProject {
  id             String              @id @default(uuid())
  type           B2BProjectType      @default(FURNITURE_LINE)
  status         B2BProjectStatus    @default(DRAFT)
  name           String
  partnerName    String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  roomType       RoomType
  style          InteriorStyle
  managerComment String?
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  roomProjectId  String?             @unique
  roomProject    RoomProject?        @relation(fields: [roomProjectId], references: [id], onDelete: SetNull)
  products       B2BProjectProduct[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([createdById])
  @@index([createdAt])
}

model B2BProjectProduct {
  id              String     @id @default(uuid())
  b2bProjectId    String
  b2bProject      B2BProject @relation(fields: [b2bProjectId], references: [id], onDelete: Cascade)
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  sortOrder       Int
  productSnapshot Json
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([b2bProjectId, productId])
  @@index([b2bProjectId, sortOrder])
  @@index([productId])
}

enum FileOwnerType {
  USER
  GUEST
}

model File {
  id String @id @default(uuid())

  ownerType FileOwnerType

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)

  originalName String
  fileName     String

  mimeType  String
  sizeBytes Int

  storageKey String
  url        String

  purpose String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestSessionId])
  @@index([ownerType])
  @@index([purpose])
}

enum CartStatus {
  ACTIVE
  ORDER_CREATED
  ABANDONED
}

enum CartItemSource {
  CATALOG
  DESIGN_PROJECT
}

model Cart {
  id String @id @default(uuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)

  status CartStatus @default(ACTIVE)

  totalAmount Int @default(0)
  currency    String @default("RUB")

  items CartItem[]
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestSessionId])
  @@index([status])
}

model CartItem {
  id String @id @default(uuid())

  cartId String
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  supplierId String

  source CartItemSource @default(CATALOG)
  roomProjectId String?
  roomProject   RoomProject? @relation(fields: [roomProjectId], references: [id], onDelete: SetNull)

  designVariantId String?
  designVariant   DesignVariant? @relation(fields: [designVariantId], references: [id], onDelete: SetNull)

  quantity Int @default(1)

  priceSnapshot        Int
  titleSnapshot        String
  imageSnapshot        String?
  availabilitySnapshot String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([supplierId])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MANUAL
  ALFABANK
}

enum FulfillmentStatus {
  NOT_STARTED
  PROCUREMENT
  PARTIALLY_PROCURED
  PROCURED
  SHIPPED
  DELIVERED
}

enum OrderItemProcurementStatus {
  NOT_STARTED
  ORDERED
  CONFIRMED_BY_SUPPLIER
  UNAVAILABLE
  REPLACEMENT_REQUIRED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SupplierOrderStatus {
  PENDING
  MANUAL_PROCESSING
  SENT
  CONFIRMED
  FAILED
  REJECTED
  CANCELED
}

model Order {
  id     String @id @default(uuid())
  number Int    @unique @default(autoincrement())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  idempotencyKey String?

  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)

  cartId String @unique
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Restrict)

  status            OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)

  subtotalAmount Int
  deliveryAmount Int
  totalAmount    Int
  currency       String @default("RUB")

  customerName  String
  customerPhone String
  customerEmail String?

  deliveryAddress    String
  deliveryCity       String?
  deliveryPostalCode String?
  deliveryComment    String?
  deliveryDate       DateTime?
  customerComment    String?
  managerComment     String?

  paidAt      DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  items          OrderItem[]
  payments       Payment[]
  supplierOrders SupplierOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([guestSessionId])
  @@index([cartId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  supplierId String

  externalProductId String

  source CartItemSource @default(CATALOG)

  roomProjectId   String?
  designVariantId String?

  quantity Int

  priceSnapshot        Int
  totalPrice           Int
  titleSnapshot        String
  imageSnapshot        String?
  availabilitySnapshot String
  supplierNameSnapshot String?
  productUrlSnapshot   String?

  procurementStatus OrderItemProcurementStatus @default(NOT_STARTED)
  managerComment    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([supplierId])
  @@index([source])
  @@index([roomProjectId])
  @@index([designVariantId])
  @@index([procurementStatus])
}

model Payment {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  externalPaymentId String?
  paymentUrl        String?

  amount   Int
  currency String @default("RUB")

  failureCode    String?
  failureMessage String?
  metadata       Json?
  paidAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([externalPaymentId])
  @@index([status])
}

model SupplierOrder {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  status SupplierOrderStatus @default(MANUAL_PROCESSING)

  externalOrderId String?

  payload         Json?
  responsePayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, supplierId])
  @@index([orderId])
  @@index([supplierId])
  @@index([status])
}
